    script: "{Governor} \uD0DC\uC218\uAC00 \uB300\uB300\uC801\uC778 \uD589\uC815
      \uAC1C\uD601\uC744 \uB2E8\uD589\uD588\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item}
      \uC218\uCE58\uAC00 {Value}\uB85C \uC870\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_SOC_033
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uCD95\uC81C \uAC1C\uCD5C \uC548\uB0B4"
    script: "\uC720\uBA85\uD55C \uB3C4\uC778\uC774 {Castle}\uC744 \uC9C0\uB098\uBA70
      \uAE38\uC870\uB97C \uC608\uC5B8\uD588\uC2B5\uB2C8\uB2E4. \uD22C\uC790 \uC2EC\uB9AC\uAC00
      \uC790\uADF9\uB418\uC5B4 {Item}\uC774 {Value} \uC624\uB985\uB2C8\uB2E4."
  - newsCode: N_DIS_034
    newsType: 2
    headline: "[\uC7AC\uB09C] \uBA54\uB69C\uAE30 \uB5BC \uC2B5\uACA9"
    script: "\uB451\uC774 \uBB34\uB108\uC838 {Castle} \uC800\uC9C0\uB300\uAC00 \uCE68\uC218\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      {Item} \uCC3D\uACE0\uAC00 \uC720\uC2E4\uB418\uC5B4 {Value}\uB9CC\uD07C\uC758
      \uD0C0\uACA9\uC744 \uC785\uC5C8\uC2B5\uB2C8\uB2E4."
  - newsCode: N_CRM_035
    newsType: 2
    headline: "[\uBC94\uC8C4] \uC7A5\uBD80 \uC870\uC791 \uC758\uD639"
    script: "\uD0DC\uC218\uC758 \uC778\uC7A5\uC774 \uB3C4\uB09C\uB2F9\uD574 \uC7A5\uBD80\uAC00
      \uC870\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item} \uC9C0\uBD84
      {Value}\uC5D0 \uB300\uD55C \uC804\uC218 \uC870\uC0AC\uAC00 \uC2E4\uC2DC\uB429\uB2C8\uB2E4."
  - newsCode: N_TEC_036
    newsType: 3
    headline: "[\uAE30\uC220] \uC131\uBCBD \uBCF4\uAC15 \uACF5\uBC95 \uC644\uC131"
    script: "\uC9C0\uB825 \uB192\uC740 \uC7A5\uC218\uAC00 \uAD70\uB7C9 \uBCF4\uC874\uBC95\uC744
      \uAC1C\uC120\uD588\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item} \uC18C\uBAA8\uC728\uC774
      {Value}\uB9CC\uD07C \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - newsCode: N_NOB_037
    newsType: 3
    headline: "[\uADC0\uC871] \uD669\uC2E4 \uD608\uD1B5 \uC778\uC99D"
    script: "{Castle}\uC758 \uD638\uC871\uC774 \uAC00\uBB38\uC758 \uC9C0\uBD84\uC744
      \uD22C\uB9E4\uD558\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4. \uBA85\uBB38\uAC00
      \uB0B4\uBD84\uC73C\uB85C {Item} \uC218\uCE58\uAC00 {Value} \uD558\uB77D\uD569\uB2C8\uB2E4."
  - newsCode: N_CHA_038
    newsType: 1
    headline: "[\uC9D5\uC870] \uBD88\uC628\uD55C \uB099\uC11C \uD3EC\uCC29"
    script: "{Castle} \uC2DC\uC7A5 \uBC14\uB2E5\uC5D0 \uD749\uD749\uD55C \uBE44\uC11D\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBBFC\uC2EC \uC774\uD0C8 \uC870\uC9D0\uC5D0
      {Item} \uC9C0\uD45C\uAC00 {Value}\uB9CC\uD07C \uD754\uB4E4\uB9BD\uB2C8\uB2E4."
  - newsCode: N_RES_039
    newsType: 3
    headline: "[\uC790\uC6D0] \uBE44\uB2E8 \uC0DD\uC0B0 \uB2E8\uC9C0 \uAC00\uB3D9"
    script: "\uD48D\uBD80\uD55C \uC218\uC790\uC6D0\uC744 \uBC14\uD0D5\uC73C\uB85C
      {Castle}\uC5D0 \uC5FC\uC804\uC774 \uC138\uC6CC\uC84C\uC2B5\uB2C8\uB2E4. \uC7AC\uC815
      \uD48D\uC694\uC640 \uD568\uAED8 {Item} \uAC00\uCE58\uAC00 {Value} \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_040
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uC6D0\uAD70 \uB2F9\uB3C4 \uD655\uC778"
    script: "\uC9C0\uB825 \uB192\uC740 \uC7A5\uC218\uAC00 \uD654\uACC4\uB97C \uC368\uC11C
      \uC801\uC758 \uBCF4\uAE09\uB85C\uB97C \uB04A\uC5C8\uC2B5\uB2C8\uB2E4. \uC804\uD669
      \uC5ED\uC804\uC73C\uB85C {Castle}\uC758 {Item}\uC774 {Value} \uBC18\uB4F1\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_041
    newsType: 4
    headline: "[\uACBD\uC81C] \uC2DC\uC7A5 \uAC1C\uBC29 \uACF5\uACE0"
    script: "{Governor} \uD0DC\uC218\uAC00 \uC0AC\uC7AC\uB97C \uD138\uC5B4 \uC2DC\uC7A5
      \uC548\uC815\uD654 \uAE30\uAE08\uC744 \uC870\uC131\uD588\uC2B5\uB2C8\uB2E4.
      {Item} \uC9C0\uC218\uAC00 {Value}\uB9CC\uD07C \uBCF4\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_POL_042
    newsType: 2
    headline: "[\uC18D\uBCF4] \uD0DC\uC218\uC758 \uB0B4\uC815 \uAC1C\uD601"
    script: "{Governor} \uD0DC\uC218\uAC00 \uC778\uADFC \uC601\uC8FC\uC640 \uB3D9\uB9F9\uC744
      \uB9FA\uC5C8\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item} \uAC00\uCE58\uAC00 {Value}\uB9CC\uD07C
      \uACF5\uACE0\uD574\uC9D1\uB2C8\uB2E4."
  - newsCode: N_SOC_043
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uCD95\uC81C \uAC1C\uCD5C \uC548\uB0B4"
    script: "{Castle} \uBC31\uC131\uB4E4\uC774 {Governor} \uD0DC\uC218\uC758 \uC120\uC815\uC744
      \uCE6D\uC1A1\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. {Item}\uC5D0 \uB300\uD55C
      \uBBFC\uC2EC \uC2E0\uB8B0\uB3C4\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_DIS_044
    newsType: 2
    headline: "[\uC7AC\uB09C] \uAC00\uBB44 \uD53C\uD574 \uBCF4\uACE0"
    script: "\uBA54\uB69C\uAE30 \uB5BC\uAC00 {Castle} \uC601\uC9C0\uB97C \uD729\uC4F8\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBCF4\uAE09 \uBB3C\uC790\uC778 {Item} \uC218\uCE58\uAC00 {Value}\uB9CC\uD07C
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - newsCode: N_CRM_045
    newsType: 2
    headline: "[\uBC94\uC8C4] \uC554\uC2DC\uC7A5 \uD3D0\uC1C4 \uC870\uCE58"
    script: "\uC9C0\uBC29 \uAD00\uB9AC\uB4E4\uC774 {Item}\uC744 \uBE7C\uB3CC\uB824
      \uBE44\uC790\uAE08\uC744 \uC870\uC131\uD55C \uC0AC\uC2E4\uC774 \uB4DC\uB7EC\uB0AC\uC2B5\uB2C8\uB2E4.
      {Value}\uB9CC\uD07C\uC758 \uC7AC\uC815 \uC190\uC2E4\uC774 \uAE30\uB85D\uB429\uB2C8\uB2E4."
  - newsCode: N_TEC_046
    newsType: 3
    headline: "[\uAE30\uC220] \uCC9C\uBB38\uD559 \uACC4\uC0B0\uBC95 \uB3C4\uC785"
    script: "{Castle}\uC758 \uACF5\uBCD1\uB4E4\uC774 \uC0C8\uB85C\uC6B4 \uC131\uBCBD
      \uBCF4\uAC15\uBC95\uC744 \uAC1C\uBC1C\uD588\uC2B5\uB2C8\uB2E4. \uC9C0\uBD84
      \uBC29\uC5B4\uB825\uACFC \uC5F0\uB3D9\uB418\uC5B4 {Item} \uAC00\uCE58\uAC00
      {Value} \uC624\uB985\uB2C8\uB2E4."
  - newsCode: N_NOB_047
    newsType: 3
    headline: "[\uADC0\uC871] \uD638\uC871 \uAD8C\uB825 \uB2E4\uD23C"
    script: "\uC911\uC559 \uADC0\uC871\uB4E4\uC774 {Castle}\uC758 {Item}\uC744 \uC804\uB7C9
      \uC9D5\uBC1C\uD558\uAE30\uB85C \uACB0\uC815\uD588\uC2B5\uB2C8\uB2E4. \uACF5\uAE09
      \uBD80\uC871\uC73C\uB85C \uAC00\uCE58\uAC00 {Value} \uD3ED\uB4F1\uD569\uB2C8\uB2E4."
  - newsCode: N_CHA_048
    newsType: 1
    headline: "[\uC9D5\uC870] \uBD88\uAE38\uD55C \uC720\uC131 \uAD00\uCE21"
    script: "\uC131\uB0B4 \uC6B0\uBB3C \uBB3C\uC774 \uD54F\uBE5B\uC73C\uB85C \uBCC0\uD588\uB2E4\uB294
      \uC18C\uBB38\uC774 \uB3CC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uACF5\uD3EC\uAC10
      \uC18D\uC5D0 {Item} \uAC70\uB798\uB7C9\uC774 {Value} \uD558\uAC15\uD569\uB2C8\uB2E4."
  - newsCode: N_RES_049
    newsType: 3
    headline: "[\uC790\uC6D0] \uBE44\uB2E8 \uC0DD\uC0B0 \uB2E8\uC9C0 \uAC00\uB3D9"
    script: "{Castle} \uC778\uADFC \uC0B0\uB9E5\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAD11\uB9E5\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC790\uC6D0 \uD655\uBCF4 \uAE30\uB300\uAC10\uC5D0
      {Item} \uC218\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_050
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uC6D0\uAD70 \uB2F9\uB3C4 \uD655\uC778"
    script: "{Castle} \uC131\uBB38\uC774 \uC801\uAD70\uC758 \uAE30\uC2B5\uC5D0 \uB3CC\uD30C\uB2F9\uD588\uC2B5\uB2C8\uB2E4.
      {Governor} \uD0DC\uC218\uAC00 \uD6C4\uD1F4\uD558\uBA70 {Item} \uC218\uCE58\uAC00
      {Value} \uAE09\uB77D\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_051
    newsType: 4
    headline: "[\uACBD\uC81C] \uC0C1\uB2E8 \uC720\uC785 \uC18C\uC2DD"
    script: "\uC11C\uC5ED\uC5D0\uC11C \uC628 \uB300\uC0C1\uB2E8\uC774 {Castle}\uC5D0
      \uC815\uCC29\uD588\uC2B5\uB2C8\uB2E4. {Item}\uC758 \uB9E4\uBB3C\uB7C9\uC774
      {Value}\uB9CC\uD07C \uD3ED\uC99D\uD569\uB2C8\uB2E4."
  - newsCode: N_POL_052
    newsType: 2
    headline: "[\uC18D\uBCF4] \uD0DC\uC218\uC758 \uB0B4\uC815 \uAC1C\uD601"
    script: "\uC0C8\uB85C\uC6B4 \uD0DC\uC218\uC758 \uBD80\uC784\uC124\uC774 \uB3CC\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. {Castle}\uC758 \uC815\uCE58\uC801 \uBD88\uC548\uC73C\uB85C
      {Item}\uC774 {Value} \uD558\uB77D\uD569\uB2C8\uB2E4."
  - newsCode: N_SOC_053
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uCD95\uC81C \uAC1C\uCD5C \uC548\uB0B4"
    script: "\uC720\uBA85\uD55C \uB3C4\uC778\uC774 {Castle}\uC744 \uC9C0\uB098\uBA70
      \uAE38\uC870\uB97C \uC608\uC5B8\uD588\uC2B5\uB2C8\uB2E4. \uD22C\uC790 \uC2EC\uB9AC\uAC00
      \uC790\uADF9\uB418\uC5B4 {Item}\uC774 {Value} \uC624\uB985\uB2C8\uB2E4."
  - newsCode: N_DIS_054
    newsType: 2
    headline: "[\uC7AC\uB09C] \uC804\uC5FC\uBCD1 \uCC3D\uAD90 \uC8FC\uC758"
    script: "\uBA54\uB69C\uAE30 \uB5BC\uAC00 {Castle} \uC601\uC9C0\uB97C \uD729\uC4F8\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBCF4\uAE09 \uBB3C\uC790\uC778 {Item} \uC218\uCE58\uAC00 {Value}\uB9CC\uD07C
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - newsCode: N_CRM_055
    newsType: 2
    headline: "[\uBC94\uC8C4] \uC554\uC2DC\uC7A5 \uD3D0\uC1C4 \uC870\uCE58"
    script: "{Castle} \uC131\uBCBD \uADFC\uCC98\uC5D0\uC11C \uB300\uADDC\uBAA8 \uBC00\uC218
      \uD604\uC7A5\uC774 \uD3EC\uCC29\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBD88\uBC95
      \uC720\uD1B5\uB41C {Item} {Value}\uAC00 \uC2DC\uC7A5\uC744 \uAD50\uB780\uD569\uB2C8\uB2E4."
  - newsCode: N_TEC_056
    newsType: 3
    headline: "[\uAE30\uC220] \uC2E0\uD615 \uBCD1\uAE30 \uBC1C\uACAC"
    script: "\uACE0\uC131\uB2A5 \uD22C\uC11D\uAE30 \uC81C\uC870\uBC95\uC774 {Castle}\uC5D0\uC11C
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uAD70\uC0AC\uC801 \uAE30\uC220
      \uC6B0\uC704\uB85C {Item}\uC774 {Value} \uC0C1\uD5A5\uB429\uB2C8\uB2E4."
  - newsCode: N_NOB_057
    newsType: 3
    headline: "[\uADC0\uC871] \uD669\uC2E4 \uD608\uD1B5 \uC778\uC99D"
    script: "{Governor} \uD0DC\uC218\uAC00 \uD669\uC2E4 \uC885\uCE5C\uC784\uC774
      \uACF5\uC2DD \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC815\uCE58\uC801
      \uAD8C\uC704 \uC0C1\uC2B9\uC73C\uB85C {Item}\uC774 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_CHA_058
    newsType: 1
    headline: "[\uC9D5\uC870] \uC6B0\uBB3C \uBB3C \uBCC0\uC0C9 \uC18C\uBB38"
    script: "{Castle} \uC2DC\uC7A5 \uBC14\uB2E5\uC5D0 \uD749\uD749\uD55C \uBE44\uC11D\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBBFC\uC2EC \uC774\uD0C8 \uC870\uC9D0\uC5D0
      {Item} \uC9C0\uD45C\uAC00 {Value}\uB9CC\uD07C \uD754\uB4E4\uB9BD\uB2C8\uB2E4."
  - newsCode: N_RES_059
    newsType: 3
    headline: "[\uC790\uC6D0] \uCCA0\uAD11\uC11D \uACE0\uAC08 \uC9D5\uD6C4"
    script: "{Castle}\uC758 \uD2B9\uC0B0\uBB3C\uC778 {Item}\uC774 \uC678\uAD6D \uC0AC\uC808\uB2E8\uC5D0\uAC8C
      \uADF9\uCC2C\uC744 \uBC1B\uC558\uC2B5\uB2C8\uB2E4. \uC218\uCD9C \uD310\uB85C
      \uD655\uB300\uB85C \uAC00\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_060
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uC6D0\uAD70 \uB2F9\uB3C4 \uD655\uC778"
    script: "\uC801\uC758 \uCCA9\uC790\uAC00 \uC131\uB0B4 \uBCF4\uAE09\uACE0\uC5D0
      \uB3C5\uC744 \uD480\uC5C8\uC2B5\uB2C8\uB2E4. \uAD70\uC0AC \uC790\uC0B0\uC778
      {Item}\uC774 {Value}\uB9CC\uD07C \uC624\uC5FC\uB418\uC5B4 \uC18C\uC2E4\uB429\uB2C8\uB2E4."
  - newsCode: N_ECO_061
    newsType: 4
    headline: "[\uACBD\uC81C] \uC0C1\uAD8C \uC7AC\uC815\uBE44 \uACF5\uACE0"
    script: "{Castle} \uC131\uB0B4 \uC0C1\uB2E8 \uC5F0\uD569\uC774 \uACB0\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      {Item}\uC758 \uAC70\uB798 \uD6A8\uC728\uC774 {Value}\uB9CC\uD07C \uAC1C\uC120\uB420
      \uC804\uB9DD\uC785\uB2C8\uB2E4."
  - newsCode: N_POL_062
    newsType: 2
    headline: "[\uC18D\uBCF4] \uBD80\uD328 \uAD00\uB9AC \uCC99\uACB0"
    script: "{Governor} \uD0DC\uC218\uAC00 \uC778\uADFC \uC601\uC8FC\uC640 \uB3D9\uB9F9\uC744
      \uB9FA\uC5C8\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item} \uAC00\uCE58\uAC00 {Value}\uB9CC\uD07C
      \uACF5\uACE0\uD574\uC9D1\uB2C8\uB2E4."
  - newsCode: N_SOC_063
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uC778\uAD6C \uC870\uC0AC \uBC1C\uD45C"
    script: "\uC131\uB0B4 \uD559\uB2F9\uC774 \uC138\uC6CC\uC838 \uC778\uC7AC\uB4E4\uC774
      \uBAA8\uC5EC\uB4ED\uB2C8\uB2E4. {Castle}\uC758 \uD589\uC815 \uC9C0\uB2A5 \uD5A5\uC0C1\uC73C\uB85C
      {Item}\uC774 {Value}\uB9CC\uD07C \uBCF4\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_DIS_064
    newsType: 2
    headline: "[\uC7AC\uB09C] \uB300\uD654\uC7AC \uBC1C\uC0DD"
    script: "\uB451\uC774 \uBB34\uB108\uC838 {Castle} \uC800\uC9C0\uB300\uAC00 \uCE68\uC218\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      {Item} \uCC3D\uACE0\uAC00 \uC720\uC2E4\uB418\uC5B4 {Value}\uB9CC\uD07C\uC758
      \uD0C0\uACA9\uC744 \uC785\uC5C8\uC2B5\uB2C8\uB2E4."
  - newsCode: N_CRM_065
    newsType: 2
    headline: "[\uBC94\uC8C4] \uC554\uC2DC\uC7A5 \uD3D0\uC1C4 \uC870\uCE58"
    script: "{Castle} \uC131\uBCBD \uADFC\uCC98\uC5D0\uC11C \uB300\uADDC\uBAA8 \uBC00\uC218
      \uD604\uC7A5\uC774 \uD3EC\uCC29\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBD88\uBC95
      \uC720\uD1B5\uB41C {Item} {Value}\uAC00 \uC2DC\uC7A5\uC744 \uAD50\uB780\uD569\uB2C8\uB2E4."
  - newsCode: N_TEC_066
    newsType: 3
    headline: "[\uAE30\uC220] \uAD70\uB7C9 \uBCF4\uC874 \uAE30\uC220"
    script: "\uC0C8\uB85C\uC6B4 \uC218\uB85C \uC815\uBE44 \uAE30\uC220\uC774 {Castle}\uC5D0
      \uB3C4\uC785\uB418\uC5C8\uC2B5\uB2C8\uB2E4. {Item} \uBCF4\uAE09 \uD6A8\uC728\uC774
      {Value}\uB9CC\uD07C \uBE44\uC57D\uC801\uC73C\uB85C \uD5A5\uC0C1\uB429\uB2C8\uB2E4."
  - newsCode: N_NOB_067
    newsType: 3
    headline: "[\uADC0\uC871] \uC790\uC6D0 \uAC15\uC81C \uC9D5\uBC1C"
    script: "\uD669\uC2E4\uC5D0\uC11C {Castle}\uC758 {Governor} \uD0DC\uC218\uC5D0\uAC8C
      \uBCF4\uBB3C\uC744 \uD558\uC0AC\uD588\uC2B5\uB2C8\uB2E4. \uD669\uC2E4 \uBE44\uD638
      \uC544\uB798 {Item}\uC774 {Value}\uB9CC\uD07C \uC624\uB985\uB2C8\uB2E4."
  - newsCode: N_CHA_068
    newsType: 1
    headline: "[\uC9D5\uC870] \uC608\uC5B8\uC801 \uB3D9\uC694 \uD655\uC0B0"
    script: "\uC544\uC774\uB4E4\uC774 \uBD80\uB974\uB294 \uB3D9\uC694\uC5D0 \uD0DC\uC218\uC758
      \uBAB0\uB77D\uC774 \uC554\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. {Castle} \uD22C\uC790\uC790\uB4E4\uC774
      {Item}\uC744 {Value}\uB9CC\uD07C \uB9E4\uB3C4\uD569\uB2C8\uB2E4."
  - newsCode: N_RES_069
    newsType: 3
    headline: "[\uC790\uC6D0] \uC0C8\uB85C\uC6B4 \uAD11\uB9E5 \uBC1C\uACAC"
    script: "{Castle} \uC778\uADFC \uC0B0\uB9E5\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAD11\uB9E5\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC790\uC6D0 \uD655\uBCF4 \uAE30\uB300\uAC10\uC5D0
      {Item} \uC218\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_070
    newsType: 4
    headline: "[\uC804\uD669] \uC131\uBB38 \uB3CC\uD30C \uBC0F \uD6C4\uD1F4"
    script: "{Castle}\uC744 \uB458\uB7EC\uC2FC \uB300\uADDC\uBAA8 \uD3EC\uC704\uB9DD\uC774
      \uD615\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uACE0\uB9BD\uB41C \uC131\uC758
      \uACBD\uC81C \uB9C8\uBE44\uB85C {Item}\uC774 {Value} \uD558\uAC15\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_071
    newsType: 4
    headline: "[\uACBD\uC81C] \uC0C1\uAD8C \uC7AC\uC815\uBE44 \uACF5\uACE0"
    script: "{Governor} \uD0DC\uC218\uAC00 \uC0AC\uC7AC\uB97C \uD138\uC5B4 \uC2DC\uC7A5
      \uC548\uC815\uD654 \uAE30\uAE08\uC744 \uC870\uC131\uD588\uC2B5\uB2C8\uB2E4.
      {Item} \uC9C0\uC218\uAC00 {Value}\uB9CC\uD07C \uBCF4\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_POL_072
    newsType: 2
    headline: "[\uC18D\uBCF4] \uD6C4\uACC4\uC790 \uACB0\uC815 \uC784\uBC15"
    script: "\uC911\uC559 \uC815\uBD80\uC758 \uC778\uC0AC\uAC00 {Castle}\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.
      {Governor}\uC758 \uC785\uC9C0\uC5D0 \uB530\uB77C {Item}\uC774 {Value}\uB9CC\uD07C
      \uC694\uB3D9\uCE69\uB2C8\uB2E4."
  - newsCode: N_SOC_073
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uC778\uAD6C \uC870\uC0AC \uBC1C\uD45C"
    script: "{Castle} \uAD11\uC7A5\uC5D0\uC11C \uB300\uADDC\uBAA8 \uC5F0\uD68C\uAC00
      \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \uBC31\uC131\uB4E4\uC758 \uB9CC\uC871\uB3C4\uAC00
      \uB192\uC544\uC9C0\uBA70 {Item} \uAC00\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_DIS_074
    newsType: 2
    headline: "[\uC7AC\uB09C] \uBA54\uB69C\uAE30 \uB5BC \uC2B5\uACA9"
    script: "\uBA54\uB69C\uAE30 \uB5BC\uAC00 {Castle} \uC601\uC9C0\uB97C \uD729\uC4F8\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBCF4\uAE09 \uBB3C\uC790\uC778 {Item} \uC218\uCE58\uAC00 {Value}\uB9CC\uD07C
      \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - newsCode: N_CRM_075
    newsType: 2
    headline: "[\uBC94\uC8C4] \uC0AC\uAE30 \uC0C1\uB2E8 \uC801\uBC1C"
    script: "{Castle} \uC2DC\uC7A5\uC744 \uC5B4\uC9C0\uB7FD\uD788\uB358 \uAC00\uC9DC
      \uAE08\uD654 \uC720\uD1B5 \uC0C1\uB2E8\uC774 \uC801\uBC1C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC555\uC218\uB41C {Item} {Value}\uB9CC\uD07C \uD68C\uC218\uB429\uB2C8\uB2E4."
  - newsCode: N_TEC_076
    newsType: 3
    headline: "[\uAE30\uC220] \uCC9C\uBB38\uD559 \uACC4\uC0B0\uBC95 \uB3C4\uC785"
    script: "{Castle}\uC758 \uACF5\uBCD1\uB4E4\uC774 \uC0C8\uB85C\uC6B4 \uC131\uBCBD
      \uBCF4\uAC15\uBC95\uC744 \uAC1C\uBC1C\uD588\uC2B5\uB2C8\uB2E4. \uC9C0\uBD84
      \uBC29\uC5B4\uB825\uACFC \uC5F0\uB3D9\uB418\uC5B4 {Item} \uAC00\uCE58\uAC00
      {Value} \uC624\uB985\uB2C8\uB2E4."
  - newsCode: N_NOB_077
    newsType: 3
    headline: "[\uADC0\uC871] \uBA85\uBB38\uAC00 \uC5F0\uD569 \uD0C4\uC0DD"
    script: "{Castle}\uC758 \uBA85\uBB38\uAC00\uB4E4\uC774 \uC5F0\uD569\uD558\uC5EC
      \uB3C5\uC810 \uC0C1\uAD8C\uC744 \uAD6C\uCD95\uD588\uC2B5\uB2C8\uB2E4. \uD638\uC871\uB4E4\uC758
      \uACB0\uC18D\uC73C\uB85C {Item} \uBCC0\uB3D9\uC774 {Value} \uB0B4\uC678\uB85C
      \uC881\uD600\uC9D1\uB2C8\uB2E4."
  - newsCode: N_CHA_078
    newsType: 1
    headline: "[\uC9D5\uC870] \uC8FC\uC220 \uC9D1\uB2E8 \uACBD\uACE0"
    script: "{Castle} \uC2DC\uC7A5 \uBC14\uB2E5\uC5D0 \uD749\uD749\uD55C \uBE44\uC11D\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uBBFC\uC2EC \uC774\uD0C8 \uC870\uC9D0\uC5D0
      {Item} \uC9C0\uD45C\uAC00 {Value}\uB9CC\uD07C \uD754\uB4E4\uB9BD\uB2C8\uB2E4."
