  - newsCode: N_RES_479
    newsType: 3
    headline: "[\uC790\uC6D0] \uD2B9\uC0B0\uBB3C \uC9C4\uC0C1 \uBA85\uB839"
    script: "\uBE44\uB2E8 \uC0DD\uC0B0 \uAE30\uC220\uC774 {Castle}\uC5D0 \uC804\uD30C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uACE0\uBD80\uAC00\uAC00\uCE58 \uC790\uC6D0\uC778 {Item}\uC758 \uC7A0\uC7AC\uB825\uC774
      {Value}\uB9CC\uD07C \uCEE4\uC9D1\uB2C8\uB2E4."
  - newsCode: N_WAR_480
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uB7B5\uC801 \uD654\uACC4 \uC131\uACF5"
    script: "\uC9C0\uB825 \uB192\uC740 \uC7A5\uC218\uAC00 \uD654\uACC4\uB97C \uC368\uC11C
      \uC801\uC758 \uBCF4\uAE09\uB85C\uB97C \uB04A\uC5C8\uC2B5\uB2C8\uB2E4. \uC804\uD669
      \uC5ED\uC804\uC73C\uB85C {Castle}\uC758 {Item}\uC774 {Value} \uBC18\uB4F1\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_481
    newsType: 4
    headline: "[\uACBD\uC81C] \uD654\uD3D0 \uAC00\uCE58 \uBCC0\uB3D9"
    script: "\uC11C\uC5ED\uC5D0\uC11C \uC628 \uB300\uC0C1\uB2E8\uC774 {Castle}\uC5D0
      \uC815\uCC29\uD588\uC2B5\uB2C8\uB2E4. {Item}\uC758 \uB9E4\uBB3C\uB7C9\uC774
      {Value}\uB9CC\uD07C \uD3ED\uC99D\uD569\uB2C8\uB2E4."
  - newsCode: N_POL_482
    newsType: 2
    headline: "[\uC18D\uBCF4] \uC778\uC0AC \uC774\uB3D9 \uD1B5\uBCF4"
    script: "{Castle} \uB0B4\uBD80 \uAD00\uB9AC\uB4E4\uC758 \uBD80\uD328 \uCC99\uACB0
      \uC791\uC5C5\uC774 \uC2DC\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4. {Item} \uC218\uAE09
      \uCCB4\uACC4\uAC00 {Value}\uB9CC\uD07C \uC815\uC0C1\uD654\uB429\uB2C8\uB2E4."
  - newsCode: N_SOC_483
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uC778\uAD6C \uC870\uC0AC \uBC1C\uD45C"
    script: "{Castle} \uAD11\uC7A5\uC5D0\uC11C \uB300\uADDC\uBAA8 \uC5F0\uD68C\uAC00
      \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \uBC31\uC131\uB4E4\uC758 \uB9CC\uC871\uB3C4\uAC00
      \uB192\uC544\uC9C0\uBA70 {Item} \uAC00\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_DIS_484
    newsType: 2
    headline: "[\uC7AC\uB09C] \uB300\uD654\uC7AC \uBC1C\uC0DD"
    script: "{Castle}\uC758 \uC8FC \uBCF4\uAE09\uCC3D\uC5D0 \uC6D0\uC778 \uBAA8\uB97C
      \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4. {Item} \uBE44\uCD95\uBD84
      \uC911 {Value}\uAC00 \uC18C\uC2E4\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - newsCode: N_CRM_485
    newsType: 2
    headline: "[\uBC94\uC8C4] \uC7A5\uBD80 \uC870\uC791 \uC758\uD639"
    script: "{Castle} \uC2DC\uC7A5\uC744 \uC5B4\uC9C0\uB7FD\uD788\uB358 \uAC00\uC9DC
      \uAE08\uD654 \uC720\uD1B5 \uC0C1\uB2E8\uC774 \uC801\uBC1C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC555\uC218\uB41C {Item} {Value}\uB9CC\uD07C \uD68C\uC218\uB429\uB2C8\uB2E4."
  - newsCode: N_TEC_486
    newsType: 3
    headline: "[\uAE30\uC220] \uC131\uBCBD \uBCF4\uAC15 \uACF5\uBC95 \uC644\uC131"
    script: "\uCC9C\uBB38\uD559\uC801\uC778 \uACC4\uC0B0\uBC95\uC744 \uB3C4\uC785\uD574
      \uBC30\uB2F9\uAE08 \uC815\uC0B0\uC774 \uC815\uAD50\uD574\uC84C\uC2B5\uB2C8\uB2E4.
      {Item} \uC218\uC775\uB960\uC774 {Value}\uB9CC\uD07C \uBCF4\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_NOB_487
    newsType: 3
    headline: "[\uADC0\uC871] \uD638\uC871 \uAD8C\uB825 \uB2E4\uD23C"
    script: "{Governor} \uD0DC\uC218\uAC00 \uD669\uC2E4 \uC885\uCE5C\uC784\uC774
      \uACF5\uC2DD \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC815\uCE58\uC801
      \uAD8C\uC704 \uC0C1\uC2B9\uC73C\uB85C {Item}\uC774 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_CHA_488
    newsType: 1
    headline: "[\uC9D5\uC870] \uC6B0\uBB3C \uBB3C \uBCC0\uC0C9 \uC18C\uBB38"
    script: "\uC544\uC774\uB4E4\uC774 \uBD80\uB974\uB294 \uB3D9\uC694\uC5D0 \uD0DC\uC218\uC758
      \uBAB0\uB77D\uC774 \uC554\uC2DC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. {Castle} \uD22C\uC790\uC790\uB4E4\uC774
      {Item}\uC744 {Value}\uB9CC\uD07C \uB9E4\uB3C4\uD569\uB2C8\uB2E4."
  - newsCode: N_RES_489
    newsType: 3
    headline: "[\uC790\uC6D0] \uC5FC\uC804 \uAC1C\uBC1C \uC2B9\uC778"
    script: "{Castle} \uC778\uADFC \uC0B0\uB9E5\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAD11\uB9E5\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC790\uC6D0 \uD655\uBCF4 \uAE30\uB300\uAC10\uC5D0
      {Item} \uC218\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_490
    newsType: 4
    headline: "[\uC804\uD669] \uBCF4\uAE09\uACE0 \uB3C5\uADF9\uBB3C \uC0AC\uAC74"
    script: "{Castle} \uC131\uBB38\uC774 \uC801\uAD70\uC758 \uAE30\uC2B5\uC5D0 \uB3CC\uD30C\uB2F9\uD588\uC2B5\uB2C8\uB2E4.
      {Governor} \uD0DC\uC218\uAC00 \uD6C4\uD1F4\uD558\uBA70 {Item} \uC218\uCE58\uAC00
      {Value} \uAE09\uB77D\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_491
    newsType: 4
    headline: "[\uACBD\uC81C] \uC0C1\uB2E8 \uC720\uC785 \uC18C\uC2DD"
    script: "{Governor} \uD0DC\uC218\uAC00 \uC0AC\uC7AC\uB97C \uD138\uC5B4 \uC2DC\uC7A5
      \uC548\uC815\uD654 \uAE30\uAE08\uC744 \uC870\uC131\uD588\uC2B5\uB2C8\uB2E4.
      {Item} \uC9C0\uC218\uAC00 {Value}\uB9CC\uD07C \uBCF4\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_POL_492
    newsType: 2
    headline: "[\uC18D\uBCF4] \uC778\uC0AC \uC774\uB3D9 \uD1B5\uBCF4"
    script: "\uC0C8\uB85C\uC6B4 \uD0DC\uC218\uC758 \uBD80\uC784\uC124\uC774 \uB3CC\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. {Castle}\uC758 \uC815\uCE58\uC801 \uBD88\uC548\uC73C\uB85C
      {Item}\uC774 {Value} \uD558\uB77D\uD569\uB2C8\uB2E4."
  - newsCode: N_SOC_493
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uC778\uAD6C \uC870\uC0AC \uBC1C\uD45C"
    script: "{Castle} \uAD11\uC7A5\uC5D0\uC11C \uB300\uADDC\uBAA8 \uC5F0\uD68C\uAC00
      \uC5F4\uB838\uC2B5\uB2C8\uB2E4. \uBC31\uC131\uB4E4\uC758 \uB9CC\uC871\uB3C4\uAC00
      \uB192\uC544\uC9C0\uBA70 {Item} \uAC00\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_DIS_494
    newsType: 2
    headline: "[\uC7AC\uB09C] \uAC00\uBB44 \uD53C\uD574 \uBCF4\uACE0"
    script: "{Castle}\uC758 \uC8FC \uBCF4\uAE09\uCC3D\uC5D0 \uC6D0\uC778 \uBAA8\uB97C
      \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4. {Item} \uBE44\uCD95\uBD84
      \uC911 {Value}\uAC00 \uC18C\uC2E4\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - newsCode: N_CRM_495
    newsType: 2
    headline: "[\uBC94\uC8C4] \uAD00\uB9AC \uD6A1\uB839 \uD3ED\uB85C"
    script: "{Castle} \uC2DC\uC7A5\uC744 \uC5B4\uC9C0\uB7FD\uD788\uB358 \uAC00\uC9DC
      \uAE08\uD654 \uC720\uD1B5 \uC0C1\uB2E8\uC774 \uC801\uBC1C\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC555\uC218\uB41C {Item} {Value}\uB9CC\uD07C \uD68C\uC218\uB429\uB2C8\uB2E4."
  - newsCode: N_TEC_496
    newsType: 3
    headline: "[\uAE30\uC220] \uC218\uB85C \uC815\uBE44 \uD601\uBA85"
    script: "\uCC9C\uBB38\uD559\uC801\uC778 \uACC4\uC0B0\uBC95\uC744 \uB3C4\uC785\uD574
      \uBC30\uB2F9\uAE08 \uC815\uC0B0\uC774 \uC815\uAD50\uD574\uC84C\uC2B5\uB2C8\uB2E4.
      {Item} \uC218\uC775\uB960\uC774 {Value}\uB9CC\uD07C \uBCF4\uC815\uB429\uB2C8\uB2E4."
  - newsCode: N_NOB_497
    newsType: 3
    headline: "[\uADC0\uC871] \uD669\uC2E4 \uBCF4\uBB3C \uD558\uC0AC"
    script: "{Governor} \uD0DC\uC218\uAC00 \uD669\uC2E4 \uC885\uCE5C\uC784\uC774
      \uACF5\uC2DD \uD655\uC778\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC815\uCE58\uC801
      \uAD8C\uC704 \uC0C1\uC2B9\uC73C\uB85C {Item}\uC774 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_CHA_498
    newsType: 1
    headline: "[\uC9D5\uC870] \uBD88\uAE38\uD55C \uC720\uC131 \uAD00\uCE21"
    script: "\uC131\uB0B4 \uC6B0\uBB3C \uBB3C\uC774 \uD54F\uBE5B\uC73C\uB85C \uBCC0\uD588\uB2E4\uB294
      \uC18C\uBB38\uC774 \uB3CC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uACF5\uD3EC\uAC10
      \uC18D\uC5D0 {Item} \uAC70\uB798\uB7C9\uC774 {Value} \uD558\uAC15\uD569\uB2C8\uB2E4."
  - newsCode: N_RES_499
    newsType: 3
    headline: "[\uC790\uC6D0] \uC0C8\uB85C\uC6B4 \uAD11\uB9E5 \uBC1C\uACAC"
    script: "{Castle} \uC778\uADFC \uC0B0\uB9E5\uC5D0\uC11C \uC0C8\uB85C\uC6B4 \uAD11\uB9E5\uC774
      \uBC1C\uACAC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC790\uC6D0 \uD655\uBCF4 \uAE30\uB300\uAC10\uC5D0
      {Item} \uC218\uCE58\uAC00 {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_500
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uB7B5\uC801 \uD654\uACC4 \uC131\uACF5"
    script: "\uC9C0\uC6D0\uAD70\uC774 {Castle}\uC5D0 \uB3C4\uCC29\uD558\uC5EC \uACF5\uC131\uC804\uC774
      \uC885\uB8CC\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uAD6D\uBC29 \uC548\uC815\uD654\uC5D0
      \uB530\uB77C {Item} \uC218\uCE58\uAC00 {Value} \uD68C\uBCF5\uB429\uB2C8\uB2E4."
