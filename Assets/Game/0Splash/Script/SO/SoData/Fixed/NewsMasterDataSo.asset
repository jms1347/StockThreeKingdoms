  - newsCode: N_NOB_357
    newsType: 3
    headline: "[\uADC0\uC871] \uC790\uC6D0 \uAC15\uC81C \uC9D5\uBC1C"
    script: "{Governor} \uD0DC\uC218\uAC00 \uD669\uC2E4 \uC885\uCE5C\uC784\uC774
