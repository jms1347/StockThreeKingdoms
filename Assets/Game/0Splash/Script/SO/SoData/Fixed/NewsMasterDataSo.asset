    headline: "[\uC790\uC6D0] \uBE44\uB2E8 \uC0DD\uC0B0 \uB2E8\uC9C0 \uAC00\uB3D9"
    script: "\uD48D\uBD80\uD55C \uC218\uC790\uC6D0\uC744 \uBC14\uD0D5\uC73C\uB85C
      {Castle}\uC5D0 \uC5FC\uC804\uC774 \uC138\uC6CC\uC84C\uC2B5\uB2C8\uB2E4. \uC7AC\uC815
      \uD48D\uC694\uC640 \uD568\uAED8 {Item} \uAC00\uCE58\uAC00 {Value} \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_320
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uB7B5\uC801 \uD654\uACC4 \uC131\uACF5"
    script: "{Castle}\uC744 \uB458\uB7EC\uC2FC \uB300\uADDC\uBAA8 \uD3EC\uC704\uB9DD\uC774
      \uD615\uC131\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uACE0\uB9BD\uB41C \uC131\uC758
      \uACBD\uC81C \uB9C8\uBE44\uB85C {Item}\uC774 {Value} \uD558\uAC15\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_321
    newsType: 4
    headline: "[\uACBD\uC81C] \uD654\uD3D0 \uAC00\uCE58 \uBCC0\uB3D9"
    script: "\uC11C\uC5ED\uC5D0\uC11C \uC628 \uB300\uC0C1\uB2E8\uC774 {Castle}\uC5D0
      \uC815\uCC29\uD588\uC2B5\uB2C8\uB2E4. {Item}\uC758 \uB9E4\uBB3C\uB7C9\uC774
      {Value}\uB9CC\uD07C \uD3ED\uC99D\uD569\uB2C8\uB2E4."
  - newsCode: N_POL_322
    newsType: 2
    headline: "[\uC18D\uBCF4] \uBD80\uD328 \uAD00\uB9AC \uCC99\uACB0"
    script: "\uC911\uC559 \uC815\uBD80\uC758 \uC778\uC0AC\uAC00 {Castle}\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.
      {Governor}\uC758 \uC785\uC9C0\uC5D0 \uB530\uB77C {Item}\uC774 {Value}\uB9CC\uD07C
      \uC694\uB3D9\uCE69\uB2C8\uB2E4."
  - newsCode: N_SOC_323
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uD6A8\uC790 \uD3EC\uC0C1 \uBBF8\uB2F4"
    script: "\uB2E4\uB978 \uC601\uC9C0\uC758 \uC720\uBBFC\uB4E4\uC774 {Castle}\uB85C
      \uB300\uAC70 \uC720\uC785\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC778\uAD6C \uC99D\uAC00\uB85C
      {Item} \uC218\uC694\uAC00 {Value} \uBCC0\uB3D9\uB429\uB2C8\uB2E4."
  - newsCode: N_DIS_324
    newsType: 2
    headline: "[\uC7AC\uB09C] \uC804\uC5FC\uBCD1 \uCC3D\uAD90 \uC8FC\uC758"
    script: "{Castle}\uC758 \uC8FC \uBCF4\uAE09\uCC3D\uC5D0 \uC6D0\uC778 \uBAA8\uB97C
      \uD654\uC7AC\uAC00 \uBC1C\uC0DD\uD588\uC2B5\uB2C8\uB2E4. {Item} \uBE44\uCD95\uBD84
      \uC911 {Value}\uAC00 \uC18C\uC2E4\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - newsCode: N_CRM_325
    newsType: 2
    headline: "[\uBC94\uC8C4] \uBC00\uC218 \uD604\uC7A5 \uC18C\uD0D5"
    script: "\uD0DC\uC218\uC758 \uC778\uC7A5\uC774 \uB3C4\uB09C\uB2F9\uD574 \uC7A5\uBD80\uAC00
      \uC870\uC791\uB418\uC5C8\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item} \uC9C0\uBD84
      {Value}\uC5D0 \uB300\uD55C \uC804\uC218 \uC870\uC0AC\uAC00 \uC2E4\uC2DC\uB429\uB2C8\uB2E4."
  - newsCode: N_TEC_326
    newsType: 3
    headline: "[\uAE30\uC220] \uC218\uB85C \uC815\uBE44 \uD601\uBA85"
    script: "\uC9C0\uB825 \uB192\uC740 \uC7A5\uC218\uAC00 \uAD70\uB7C9 \uBCF4\uC874\uBC95\uC744
      \uAC1C\uC120\uD588\uC2B5\uB2C8\uB2E4. {Castle}\uC758 {Item} \uC18C\uBAA8\uC728\uC774
      {Value}\uB9CC\uD07C \uAC10\uC18C\uD569\uB2C8\uB2E4."
  - newsCode: N_NOB_327
    newsType: 3
    headline: "[\uADC0\uC871] \uD669\uC2E4 \uBCF4\uBB3C \uD558\uC0AC"
    script: "{Castle}\uC758 \uBA85\uBB38\uAC00\uB4E4\uC774 \uC5F0\uD569\uD558\uC5EC
      \uB3C5\uC810 \uC0C1\uAD8C\uC744 \uAD6C\uCD95\uD588\uC2B5\uB2C8\uB2E4. \uD638\uC871\uB4E4\uC758
      \uACB0\uC18D\uC73C\uB85C {Item} \uBCC0\uB3D9\uC774 {Value} \uB0B4\uC678\uB85C
      \uC881\uD600\uC9D1\uB2C8\uB2E4."
  - newsCode: N_CHA_328
    newsType: 1
    headline: "[\uC9D5\uC870] \uBD88\uC628\uD55C \uB099\uC11C \uD3EC\uCC29"
    script: "\uC131\uB0B4 \uC6B0\uBB3C \uBB3C\uC774 \uD54F\uBE5B\uC73C\uB85C \uBCC0\uD588\uB2E4\uB294
      \uC18C\uBB38\uC774 \uB3CC\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uACF5\uD3EC\uAC10
      \uC18D\uC5D0 {Item} \uAC70\uB798\uB7C9\uC774 {Value} \uD558\uAC15\uD569\uB2C8\uB2E4."
  - newsCode: N_RES_329
    newsType: 3
    headline: "[\uC790\uC6D0] \uBE44\uB2E8 \uC0DD\uC0B0 \uB2E8\uC9C0 \uAC00\uB3D9"
