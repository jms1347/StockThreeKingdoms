      {Castle}\uC5D0 \uC5FC\uC804\uC774 \uC138\uC6CC\uC84C\uC2B5\uB2C8\uB2E4. \uC7AC\uC815
      \uD48D\uC694\uC640 \uD568\uAED8 {Item} \uAC00\uCE58\uAC00 {Value} \uC99D\uAC00\uD569\uB2C8\uB2E4."
  - newsCode: N_WAR_330
    newsType: 4
    headline: "[\uC804\uD669] \uC9C0\uB7B5\uC801 \uD654\uACC4 \uC131\uACF5"
    script: "\uC9C0\uB825 \uB192\uC740 \uC7A5\uC218\uAC00 \uD654\uACC4\uB97C \uC368\uC11C
      \uC801\uC758 \uBCF4\uAE09\uB85C\uB97C \uB04A\uC5C8\uC2B5\uB2C8\uB2E4. \uC804\uD669
      \uC5ED\uC804\uC73C\uB85C {Castle}\uC758 {Item}\uC774 {Value} \uBC18\uB4F1\uD569\uB2C8\uB2E4."
  - newsCode: N_ECO_331
    newsType: 4
    headline: "[\uACBD\uC81C] \uD654\uD3D0 \uAC00\uCE58 \uBCC0\uB3D9"
    script: "\uD669\uC2E4\uC5D0\uC11C {Castle}\uC5D0 \uC9C1\uC811 \uD654\uD3D0 \uC8FC\uC870\uAD8C\uC744
      \uBD80\uC5EC\uD588\uC2B5\uB2C8\uB2E4. {Item}\uC758 \uC790\uBCF8 \uAC00\uCE58\uAC00
      {Value} \uC0C1\uC2B9\uD569\uB2C8\uB2E4."
  - newsCode: N_POL_332
    newsType: 2
    headline: "[\uC18D\uBCF4] \uD6C4\uACC4\uC790 \uACB0\uC815 \uC784\uBC15"
    script: "\uC911\uC559 \uC815\uBD80\uC758 \uC778\uC0AC\uAC00 {Castle}\uC5D0 \uB3C4\uCC29\uD588\uC2B5\uB2C8\uB2E4.
      {Governor}\uC758 \uC785\uC9C0\uC5D0 \uB530\uB77C {Item}\uC774 {Value}\uB9CC\uD07C
      \uC694\uB3D9\uCE69\uB2C8\uB2E4."
  - newsCode: N_SOC_333
    newsType: 1
    headline: "[\uBBFC\uC2EC] \uBC31\uC131\uB4E4\uC758 \uCE6D\uC1A1"
    script: "\uB2E4\uB978 \uC601\uC9C0\uC758 \uC720\uBBFC\uB4E4\uC774 {Castle}\uB85C
      \uB300\uAC70 \uC720\uC785\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC778\uAD6C \uC99D\uAC00\uB85C
      {Item} \uC218\uC694\uAC00 {Value} \uBCC0\uB3D9\uB429\uB2C8\uB2E4."
  - newsCode: N_DIS_334
    newsType: 2
    headline: "[\uC7AC\uB09C] \uAC00\uBB44 \uD53C\uD574 \uBCF4\uACE0"
    script: "\uB451\uC774 \uBB34\uB108\uC838 {Castle} \uC800\uC9C0\uB300\uAC00 \uCE68\uC218\uB418\uC5C8\uC2B5\uB2C8\uB2E4.
