    newsType: 2
    headline: "[\uC18D\uBCF4] \uBD80\uD328 \uAD00\uB9AC \uCC99\uACB0"
    script: "{Governor} \uD0DC\uC218\uAC00 \uC778\uADFC \uC601\uC8FC\uC640 \uB3D9\uB9F9\uC744
