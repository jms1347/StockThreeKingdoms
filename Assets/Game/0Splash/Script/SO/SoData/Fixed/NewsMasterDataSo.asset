    newsType: 3
    headline: "[\uADC0\uC871] \uD638\uC871 \uAD8C\uB825 \uB2E4\uD23C"
    script: "\uC911\uC559 \uADC0\uC871\uB4E4\uC774 {Castle}\uC758 {Item}\uC744 \uC804\uB7C9
